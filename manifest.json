{
  "manifest_version": 2,
  "name": "Eyes On You",
  "version": "1.0",
  "description": "Tracker Blocker",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://*/*"
  ],
"icons": {
  "16": "icon16.png",
  "48": "icon48.png",
  "128": "icon128.png"
  },
  "browser_action": {
  "default_popup": "popup.html",
  "default_icon": "icon16.png"
},
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
    
  ]
}